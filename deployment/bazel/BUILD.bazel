"""
BUILD.bazel — Emacs source build orchestration via Bazel genrules.

Targets
-------
  //:emacs_package      Build Emacs 31.1 (stable tarball) → emacs-31.1-install.tar.xz
                                                       + emacs-31.1-config.log
  //:emacs_ref_package  Build any git ref/commit via EMACS_REF env var (default: master)
                                                       → emacs-ref-install.tar.xz
                                                       + emacs-ref-config.log
  //:fonts              Bundle programming fonts → fonts.tar.gz

  bazel run targets (build artifact + install/remove side effects):
  //:install            Install stable Emacs 31.1 into ~/.local/
  //:install_ref        Install ref/commit build (set EMACS_REF env var first)
  //:install_fonts      Install fonts into ~/.local/share/fonts/emacs/
  //:remove             Uninstall Emacs from ~/.local/
  //:remove_fonts       Uninstall fonts from ~/.local/share/fonts/emacs/

GUI Toolkit (EMACS_TOOLKIT, default: auto-detect)
-------------------------------------------
  Auto-detection (when EMACS_TOOLKIT is unset):
    Wayland session (XDG_SESSION_TYPE=wayland or WAYLAND_DISPLAY set) → pgtk
    X11 session                                                        → lucid

  lucid   Lucid (Athena/Xaw) toolkit — stable, X11 only
            deps: libxaw7-dev libxt-dev
  pgtk    Pure GTK3 — native Wayland client + X11 via GTK backend
            deps: libgtk-3-dev
            warning: running under X11 triggers an Emacs warning about
            unsupported configuration, crashes on large selections, and
            keyboard input problems.  Only use in a native Wayland session.
  gtk3    GTK3 with X11 — Wayland only via XWayland
            deps: libgtk-3-dev

Examples
--------
  # Stable build + install (one step)
  bazel run //:install

  # Stable build with pgtk toolkit
  EMACS_TOOLKIT=pgtk bazel build //:emacs_package

  # Ref build + install
  EMACS_REF=emacs-31.1 bazel run //:install_ref

  # Ref build with pgtk toolkit
  EMACS_REF=emacs-31.1 EMACS_TOOLKIT=pgtk bazel run //:install_ref

  # Fonts: install / remove
  bazel run //:install_fonts
  bazel run //:remove_fonts

  # Emacs: remove
  bazel run //:remove

  # Build only (no install)
  bazel build //:emacs_package
  EMACS_REF=master bazel build //:emacs_ref_package

Caching
-------
  Stable (//:emacs_package): fully cached by Bazel (SHA256-pinned tarball input).
  Ref    (//:emacs_ref_package): cached per EMACS_REF value, tracked via
         --action_env=EMACS_REF in .bazelrc. Changing EMACS_REF busts the cache.
         Note: for mutable refs (master, emacs-30) the cache may be stale;
         use `bazel build --action_env=EMACS_REF_FORCE=$(date +%s)` to force rebuild.
  Toolkit: EMACS_TOOLKIT is tracked via --action_env=EMACS_TOOLKIT in .bazelrc,
         so lucid and pgtk builds are cached independently.
  System libraries: the genrules run unsandboxed (local = True) and probe the
         host at build time, so upgrading a system library does not bust the
         cache — rebuild with ./deploy.sh --reforce.

libtree-sitter (EMACS_TREE_SITTER, default: auto)
-------------------------------------------------
  auto     Use the system library if pkg-config reports tree-sitter >= 0.25
           (grammar ABI 15), else the copy built by //:libtree_sitter.
           Ubuntu 24.04 (0.20.8) → bundled; Arch/EndeavourOS → system.
  system   Require the system library; fail if it is missing or too old.
  bundled  Always use //:libtree_sitter (bundled into the tarball, found at
           runtime via rpath $HOME/.local/lib).
  Either way the built Emacs must report treesit-library-abi-version >= 15.

Build diagnostics
-----------------
  Feature guard: after configure, src/config.h is checked for every required
         feature (RSVG, GIF, SQLITE3, LIBXML2, ...).  configure silently drops
         a feature whose -dev package is missing, so the build fails instead.
  config.log: declared output of both Emacs genrules; locate it with
         `bazel cquery //:emacs_package --output=files`.
  On failure: Bazel discards declared outputs, so the tail of config.log is
         printed to stderr and a copy is kept at
         ~/.cache/emacs-bazel/config.log.failed.  The scratch tree under /tmp
         is removed on both success and failure.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# ---------------------------------------------------------------------------
# Common configure flags
# ---------------------------------------------------------------------------

CONFIGURE_FLAGS = " ".join([
    "--with-native-compilation=aot",
    "--with-tree-sitter",
    "--with-modules",
    "--with-sqlite3",
    "--with-harfbuzz",
    "--with-compress-install",
    "--with-threads",
    "--with-rsvg",
    "--with-jpeg",
    "--with-png",
    "--with-gif",
    "--with-tiff",
    "--with-xpm",
    "--with-gnutls",
    "--with-dbus",
    "--with-mailutils",
])

GIT_URL = "https://git.savannah.gnu.org/git/emacs.git"

# Oldest system libtree-sitter accepted instead of the bundled one: 0.25 is the
# first release supporting grammar ABI 15, which most upstream grammars now
# emit.  Ubuntu 24.04 ships 0.20.8 (ABI <= 14), so it always uses the bundle.
TREE_SITTER_MIN_SYSTEM_VERSION = "0.25.0"

# Shell fragment shared by both Emacs genrules: selects the system
# libtree-sitter when it is new enough, otherwise unpacks the staging tarball
# built by //:libtree_sitter and exports the env vars that point configure at
# it.  EMACS_TREE_SITTER=auto|system|bundled (default auto) overrides the
# choice.  Requires LIBTREE_SITTER_TAR (absolute) and REAL_HOME; sets TS_SOURCE.
_TREE_SITTER_SETUP = """
        TS_MODE="$${EMACS_TREE_SITTER:-auto}"
        TS_MIN_SYSTEM=""" + '"' + TREE_SITTER_MIN_SYSTEM_VERSION + '"' + """
        TS_SYSTEM_VERSION="$$(pkg-config --modversion tree-sitter 2>/dev/null || echo none)"
        if pkg-config --atleast-version="$$TS_MIN_SYSTEM" tree-sitter 2>/dev/null; then
            TS_SYSTEM_OK=1
        else
            TS_SYSTEM_OK=0
        fi
        case "$$TS_MODE" in
          auto)
            if (( TS_SYSTEM_OK )); then TS_SOURCE=system; else TS_SOURCE=bundled; fi ;;
          system)
            if (( ! TS_SYSTEM_OK )); then
                echo "ERROR: EMACS_TREE_SITTER=system, but system libtree-sitter is $$TS_SYSTEM_VERSION (need >= $$TS_MIN_SYSTEM)" >&2
                exit 1
            fi
            TS_SOURCE=system ;;
          bundled)
            TS_SOURCE=bundled ;;
          *) echo "ERROR: Unknown EMACS_TREE_SITTER '$$TS_MODE'. Valid values: auto, system, bundled" >&2; exit 1 ;;
        esac

        if [[ "$$TS_SOURCE" == system ]]; then
            echo "==> libtree-sitter: system $$TS_SYSTEM_VERSION"
        else
            echo "==> libtree-sitter: bundled (system: $$TS_SYSTEM_VERSION, need >= $$TS_MIN_SYSTEM)"
            TS_STAGING=$$(mktemp -d)
            tar -xf "$$LIBTREE_SITTER_TAR" -C "$$TS_STAGING"
            export PKG_CONFIG_PATH="$$TS_STAGING/lib/pkgconfig$${PKG_CONFIG_PATH:+:$$PKG_CONFIG_PATH}"
            export LIBRARY_PATH="$$TS_STAGING/lib$${LIBRARY_PATH:+:$$LIBRARY_PATH}"
            export LD_LIBRARY_PATH="$$TS_STAGING/lib$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}"
            export LDFLAGS="$$LDFLAGS -L$$TS_STAGING/lib -Wl,-rpath,$$REAL_HOME/.local/lib"
            # Prepend staged headers so they shadow any system libtree-sitter-dev
            # (e.g. Ubuntu 24.04's stale 0.20.8 at /usr/include/tree_sitter/api.h).
            export CPPFLAGS="-I$$TS_STAGING/include $${CPPFLAGS:-}"
        fi
"""

# Shell fragment run in the build dir after `make install`: checks that the
# built Emacs really supports grammar ABI 15 (catching a build that picked up
# a stale tree_sitter/api.h), then, for the bundled library only, copies the
# .so files into the install tree so the rpath ($$HOME/.local/lib) is
# satisfied at runtime without a system install.  Requires TS_SOURCE,
# STAGING_DIR and PREFIX.
_TREE_SITTER_FINISH = """
        TS_ABI="$$(./src/emacs -Q --batch --eval '(princ (treesit-library-abi-version))' || true)"
        if ! [[ "$$TS_ABI" =~ ^[0-9]+$$ ]] || (( TS_ABI < 15 )); then
            echo "ERROR: built Emacs supports tree-sitter grammar ABI '$$TS_ABI', need >= 15 ($$TS_SOURCE libtree-sitter)" >&2
            exit 1
        fi
        echo "==> tree-sitter grammar ABI: $$TS_ABI ($$TS_SOURCE libtree-sitter)"

        if [[ "$$TS_SOURCE" == bundled ]]; then
            mkdir -p "$$STAGING_DIR$$PREFIX/lib"
            cp -a "$$TS_STAGING/lib"/libtree-sitter.so* "$$STAGING_DIR$$PREFIX/lib/"
        fi
"""

# Shell fragment shared by both Emacs genrules: creates the scratch tree and
# an EXIT trap that removes it (and TS_STAGING) on success and failure alike.
# If the build dies before configure succeeded, the trap first saves and
# prints config.log, since Bazel discards a failed action's declared outputs.
# Requires REAL_HOME; sets WORK, STAGING_DIR, BUILD_DIR.
_WORK_SETUP = """
        WORK=$$(mktemp -d)
        STAGING_DIR="$$WORK/staging"
        BUILD_DIR="$$WORK/build"
        CONFIGURED=0
        FAILED_LOG="$$REAL_HOME/.cache/emacs-bazel/config.log.failed"
        cleanup() {
            local rc=$$?
            if (( rc != 0 && CONFIGURED == 0 )) && [[ -f "$$BUILD_DIR/config.log" ]]; then
                mkdir -p "$$(dirname "$$FAILED_LOG")"
                cp "$$BUILD_DIR/config.log" "$$FAILED_LOG"
                echo "==> configure failed; tail of config.log (full copy: $$FAILED_LOG):" >&2
                tail -n 40 "$$BUILD_DIR/config.log" >&2
            fi
            rm -rf "$$WORK" "$${TS_STAGING:-}"
        }
        trap cleanup EXIT
"""

# Shell fragment run right after ./configure in the build dir: publishes
# config.log as a declared output and fails if configure silently disabled a
# required feature (it does so for a missing -dev package even when
# --with-<feature> is passed).  Requires CONFIG_LOG_ABS and EFFECTIVE_TOOLKIT.
_POST_CONFIGURE = """
        cp config.log "$$CONFIG_LOG_ABS"

        REQUIRED_FEATURES=(HAVE_RSVG HAVE_GIF HAVE_PNG HAVE_JPEG HAVE_TIFF
                           HAVE_SQLITE3 HAVE_LIBXML2 HAVE_LCMS2 HAVE_TREE_SITTER
                           HAVE_NATIVE_COMP HAVE_GNUTLS HAVE_HARFBUZZ HAVE_DBUS
                           HAVE_MODULES THREADS_ENABLED)
        # configure only enables XPM for X11 toolkits, never for pgtk.
        if [[ "$$EFFECTIVE_TOOLKIT" != pgtk ]]; then
            REQUIRED_FEATURES+=(HAVE_XPM)
        fi
        MISSING=()
        for f in "$${REQUIRED_FEATURES[@]}"; do
            grep -q "^#define $$f 1" src/config.h || MISSING+=("$$f")
        done
        if (( $${#MISSING[@]} )); then
            echo "ERROR: configure disabled required features: $${MISSING[*]}" >&2
            echo "Install the matching -dev packages (see emacs-pkgs-ubuntu24.txt)." >&2
            exit 1
        fi
        CONFIGURED=1
"""

# ---------------------------------------------------------------------------
# libtree-sitter (built from source for ABI-15 support)
# Produces a staging tree under lib/ and include/ in the output directory,
# consumed by the Emacs genrules via TREE_SITTER_STAGING.
# ---------------------------------------------------------------------------

genrule(
    name = "libtree_sitter",
    srcs = ["@libtree_sitter_src//:all"],
    outs = ["libtree-sitter-staging.tar"],
    cmd = """
        set -euo pipefail
        OUTPUT_ABS="$$PWD/$@"

        # Locate the source root from any known file in the archive.
        SRC=$$(dirname $$(echo $(locations @libtree_sitter_src//:all) | tr ' ' '\\n' | grep 'Makefile$$' | head -1))

        STAGING=$$(mktemp -d)
        trap 'rm -rf "$$STAGING"' EXIT

        # tree-sitter's Makefile honours PREFIX for installation.
        make -C "$$SRC" -j$$(nproc --ignore=2)
        make -C "$$SRC" PREFIX="$$STAGING" install

        tar -cf "$$OUTPUT_ABS" -C "$$STAGING" .
    """,
    local = True,
)

# ---------------------------------------------------------------------------
# Stable build (Emacs 31.1 tarball via @emacs_src — reproducible)
# ---------------------------------------------------------------------------

genrule(
    name = "emacs_package",
    srcs = [
        "@emacs_src//:all",
        "@emacs_src//:configure",
        "//:libtree_sitter",
    ],
    outs = [
        "emacs-31.1-install.tar.xz",
        "emacs-31.1-config.log",
    ],
    cmd = """
        set -euo pipefail

        # Capture absolute output paths before any cd (Bazel's locations are execroot-relative).
        OUTPUT_ABS="$$PWD/$(location emacs-31.1-install.tar.xz)"
        CONFIG_LOG_ABS="$$PWD/$(location emacs-31.1-config.log)"

        # Establish the real home dir — genrule env strips $$HOME.
        REAL_HOME="/home/$$(whoami)"
        PREFIX="$$REAL_HOME/.local"

        # Locate the source root via the single exported 'configure' file path.
        # This avoids embedding all source paths ($$(locations :all) = 444KB).
        CONFIGURE_PATH="$(location @emacs_src//:configure)"
        SRC_ROOT="$$(realpath $$(dirname "$$CONFIGURE_PATH"))"
""" + _WORK_SETUP + """
        mkdir -p "$$STAGING_DIR" "$$BUILD_DIR"

        cp -a "$$SRC_ROOT/." "$$BUILD_DIR/"

        # Capture absolute path to the libtree-sitter tarball before cd.
        LIBTREE_SITTER_TAR="$$PWD/$(location //:libtree_sitter)"

        cd "$$BUILD_DIR"

        # libgccjit has no pkg-config file; locate libgccjit.h to set
        # include/lib paths.  On Debian/Ubuntu it lives under
        # /usr/lib/gcc/x86_64-linux-gnu/<ver>/include/; on Arch/EndeavourOS
        # it is simply in /usr/include/ with the .so in /usr/lib/.
        GCC_LIBDIR=$$(dirname "$$(find /usr/lib/gcc/x86_64-linux-gnu -name libgccjit.h 2>/dev/null | sort -V | tail -1)")
        if [[ -n "$$GCC_LIBDIR" && "$$GCC_LIBDIR" != "." ]]; then
            # Debian/Ubuntu layout: header under GCC versioned dir.
            # Expose only the libgccjit headers: -I on the whole dir would
            # shadow the compiler's own headers with that GCC's internal ones
            # (e.g. gcc-14's stdckdint.h breaks a gcc-13 or clang build).
            mkdir -p "$$WORK/gccjit-include"
            ln -s "$$GCC_LIBDIR"/libgccjit*.h "$$WORK/gccjit-include/"
            export CPPFLAGS="-I$$WORK/gccjit-include"
            export LDFLAGS="-L$$(dirname $$GCC_LIBDIR) -Wl,-rpath,$$(dirname $$GCC_LIBDIR)"
        elif [[ -f /usr/include/libgccjit.h ]]; then
            # Arch/EndeavourOS layout: header in /usr/include, lib in /usr/lib
            export CPPFLAGS=""
            export LDFLAGS=""
        else
            echo "ERROR: libgccjit.h not found — install libgccjit (Arch) or libgccjit-XX-dev (Debian)" >&2
            exit 1
        fi
""" + _TREE_SITTER_SETUP + """
        # Compiler: EMACS_CC env var (set via --action_env=EMACS_CC or deploy.sh --cc).
        # Defaults to clang; pass EMACS_CC=gcc to build with GCC instead.
        CC="$${EMACS_CC:-clang}"

        # Toolkit selection (EMACS_TOOLKIT env var, tracked via --action_env in .bazelrc).
        # When unset, auto-detects from XDG_SESSION_TYPE / WAYLAND_DISPLAY:
        #   Wayland session → pgtk   (native Wayland client via GTK backend)
        #   X11 session     → lucid  (stable Athena/Xaw toolkit, default)
        # Override: EMACS_TOOLKIT=lucid|pgtk|gtk3 bazel build //:emacs_package
        if [[ -n "$${EMACS_TOOLKIT:-}" ]]; then
            EFFECTIVE_TOOLKIT="$$EMACS_TOOLKIT"
        elif [[ "$${XDG_SESSION_TYPE:-}" == "wayland" ]] || [[ -n "$${WAYLAND_DISPLAY:-}" ]]; then
            EFFECTIVE_TOOLKIT="pgtk"
            echo "==> Auto-detected Wayland session → toolkit: pgtk"
        else
            EFFECTIVE_TOOLKIT="lucid"
            echo "==> Auto-detected X11 session → toolkit: lucid"
        fi
        case "$$EFFECTIVE_TOOLKIT" in
          lucid) TOOLKIT_FLAG="--with-x-toolkit=lucid" ;;
          pgtk)  TOOLKIT_FLAG="--with-pgtk" ;;
          gtk3)  TOOLKIT_FLAG="--with-x-toolkit=gtk3" ;;
          *) echo "ERROR: Unknown EMACS_TOOLKIT '$$EFFECTIVE_TOOLKIT'. Valid values: lucid, pgtk, gtk3" >&2; exit 1 ;;
        esac

        [[ -x ./autogen.sh ]] && ./autogen.sh
        CC="$$CC" ./configure --prefix="$$PREFIX" $$TOOLKIT_FLAG """ + CONFIGURE_FLAGS + """
""" + _POST_CONFIGURE + """
        make -j$$(nproc --ignore=2)
        # DESTDIR stages files under staging/<prefix>; internal paths still say <prefix>.
        make install DESTDIR="$$STAGING_DIR"
""" + _TREE_SITTER_FINISH + """
        tar -cJf "$$OUTPUT_ABS" -C "$$STAGING_DIR$$PREFIX" .
    """,
    # local = True: disable sandbox so system libraries are reachable.
    local = True,
)

# ---------------------------------------------------------------------------
# Ref build — any branch, tag, or commit SHA via EMACS_REF env var.
# Tracked by --action_env=EMACS_REF in .bazelrc (different values = different
# cache entries). EMACS_REF defaults to "master" when unset.
# ---------------------------------------------------------------------------

genrule(
    name = "emacs_ref_package",
    srcs = ["//:libtree_sitter"],
    outs = [
        "emacs-ref-install.tar.xz",
        "emacs-ref-config.log",
    ],
    cmd = """
        set -euo pipefail

        # Capture absolute output paths before any cd (Bazel's locations are execroot-relative).
        OUTPUT_ABS="$$PWD/$(location emacs-ref-install.tar.xz)"
        CONFIG_LOG_ABS="$$PWD/$(location emacs-ref-config.log)"

        # Establish the real home dir — genrule env strips $$HOME.
        REAL_HOME="/home/$$(whoami)"
        PREFIX="$$REAL_HOME/.local"

        REF="$${EMACS_REF:-master}"
        GIT_URL=""" + '"' + GIT_URL + '"' + """
""" + _WORK_SETUP + """
        mkdir -p "$$STAGING_DIR"

        # Detect whether REF is a commit SHA (hex-only, 7-40 chars).
        # SHAs cannot be shallow-cloned from Savannah, so we use a partial
        # (blobless) clone instead.
        if [[ "$$REF" =~ ^[0-9a-fA-F]{7,40}$$ ]]; then
            echo "==> Fetching commit $$REF (blobless clone)"
            git clone --filter=blob:none "$$GIT_URL" "$$BUILD_DIR"
            git -C "$$BUILD_DIR" checkout "$$REF"
        else
            echo "==> Cloning ref '$$REF' (shallow)"
            git clone --depth 1 --branch "$$REF" "$$GIT_URL" "$$BUILD_DIR"
        fi

        # Capture absolute path to the libtree-sitter tarball before cd.
        LIBTREE_SITTER_TAR="$$PWD/$(location //:libtree_sitter)"

        cd "$$BUILD_DIR"
        ./autogen.sh
        GCC_LIBDIR=$$(dirname "$$(find /usr/lib/gcc/x86_64-linux-gnu -name libgccjit.h 2>/dev/null | sort -V | tail -1)")
        if [[ -n "$$GCC_LIBDIR" && "$$GCC_LIBDIR" != "." ]]; then
            # Only the libgccjit headers; see emacs_package.
            mkdir -p "$$WORK/gccjit-include"
            ln -s "$$GCC_LIBDIR"/libgccjit*.h "$$WORK/gccjit-include/"
            export CPPFLAGS="-I$$WORK/gccjit-include"
            export LDFLAGS="-L$$(dirname $$GCC_LIBDIR) -Wl,-rpath,$$(dirname $$GCC_LIBDIR)"
        elif [[ -f /usr/include/libgccjit.h ]]; then
            export CPPFLAGS=""
            export LDFLAGS=""
        else
            echo "ERROR: libgccjit.h not found — install libgccjit (Arch) or libgccjit-XX-dev (Debian)" >&2
            exit 1
        fi
""" + _TREE_SITTER_SETUP + """
        CC="$${EMACS_CC:-clang}"
        if [[ -n "$${EMACS_TOOLKIT:-}" ]]; then
            EFFECTIVE_TOOLKIT="$$EMACS_TOOLKIT"
        elif [[ "$${XDG_SESSION_TYPE:-}" == "wayland" ]] || [[ -n "$${WAYLAND_DISPLAY:-}" ]]; then
            EFFECTIVE_TOOLKIT="pgtk"
            echo "==> Auto-detected Wayland session → toolkit: pgtk"
        else
            EFFECTIVE_TOOLKIT="lucid"
            echo "==> Auto-detected X11 session → toolkit: lucid"
        fi
        case "$$EFFECTIVE_TOOLKIT" in
          lucid) TOOLKIT_FLAG="--with-x-toolkit=lucid" ;;
          pgtk)  TOOLKIT_FLAG="--with-pgtk" ;;
          gtk3)  TOOLKIT_FLAG="--with-x-toolkit=gtk3" ;;
          *) echo "ERROR: Unknown EMACS_TOOLKIT '$$EFFECTIVE_TOOLKIT'. Valid values: lucid, pgtk, gtk3" >&2; exit 1 ;;
        esac
        CC="$$CC" ./configure --prefix="$$PREFIX" $$TOOLKIT_FLAG """ + CONFIGURE_FLAGS + """
""" + _POST_CONFIGURE + """
        make -j$$(nproc --ignore=2)
        make install DESTDIR="$$STAGING_DIR"
""" + _TREE_SITTER_FINISH + """
        tar -cJf "$$OUTPUT_ABS" -C "$$STAGING_DIR$$PREFIX" .
    """,
    local = True,
)

# ---------------------------------------------------------------------------
# Deploy targets
#
# Bazel 9 removed sh_binary from the built-in rule set (it now lives in
# rules_shell). Rather than add that dependency, deployment is handled by
# deploy.sh in this directory, which builds the appropriate target and
# extracts the resulting tarball into ~/.local/.
#
# Usage:
#   ./deploy.sh              # stable 31.1
#   ./deploy.sh --ref REF    # any git ref / commit SHA
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Fonts target
#
# Downloads programming fonts via Bazel (JetBrains Mono, Fira Code,
# Noto Sans Mono) and bundles them into fonts.tar.gz.
#
# Usage:
#   bazel --nohome_rc build //:fonts
#   ./deploy_fonts.sh    # build + install to ~/.local/share/fonts/emacs/
# ---------------------------------------------------------------------------

genrule(
    name = "fonts",
    srcs = [
        "@font_jetbrains_mono//:ttf_files",
        "@font_fira_code//:ttf_files",
        "@font_noto_sans_mono_regular//file",
        "@font_noto_sans_mono_bold//file",
    ],
    outs = ["fonts.tar.gz"],
    cmd = """
        set -euo pipefail
        OUTPUT_ABS="$$PWD/$@"
        STAGING="$$(mktemp -d)"
        trap 'rm -rf "$$STAGING"' EXIT

        # $(SRCS) expands to all source file paths (execroot-relative).
        # Copy each font into the flat staging directory.
        for f in $(SRCS); do
            cp "$$f" "$$STAGING/$$(basename $$f)"
        done

        tar -czf "$$OUTPUT_ABS" -C "$$STAGING" .
    """,
)

# ---------------------------------------------------------------------------
# bazel run targets — install / remove
#
# Each sh_binary declares the relevant build artifact as a data dependency
# so Bazel builds it automatically before running the installer script.
# The script locates the artifact via the $RUNFILES_DIR mechanism.
#
# Usage:
#   bazel run //:install                              # stable Emacs 31.1
#   EMACS_REF=emacs-31.1 bazel run //:install_ref   # any git ref
#   bazel run //:install_fonts
#   bazel run //:remove                              # Emacs 31.1
#   bazel run //:remove_fonts
# ---------------------------------------------------------------------------

sh_binary(
    name = "install",
    srcs = ["install_emacs.sh"],
    data = ["//:emacs_package"],
)

sh_binary(
    name = "install_ref",
    srcs = ["install_emacs_ref.sh"],
    data = ["//:emacs_ref_package"],
)

sh_binary(
    name = "install_fonts",
    srcs = ["install_fonts.sh"],
    data = ["//:fonts"],
)

sh_binary(
    name = "remove",
    srcs = ["remove.sh"],
)

sh_binary(
    name = "remove_fonts",
    srcs = ["remove_fonts.sh"],
)

