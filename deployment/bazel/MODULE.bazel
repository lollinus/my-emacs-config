"""
Bazel build for GNU Emacs.

Targets:
  //:emacs_package     — build Emacs 31.1 from the official tarball (reproducible)
  //:emacs_ref_package — build any git ref/commit via EMACS_REF env var
  //:fonts             — bundle programming fonts for ~/.local/share/fonts/emacs/

  bazel run targets (build + install/remove in one step):
  //:install           — install stable Emacs 31.1 into ~/.local/
  //:install_ref       — install ref/commit build (set EMACS_REF first)
  //:install_fonts     — install programming fonts into ~/.local/share/fonts/emacs/
  //:remove            — uninstall Emacs from ~/.local/
  //:remove_fonts      — uninstall fonts from ~/.local/share/fonts/emacs/

Prerequisites (install system packages first):
  sudo apt install $(grep -v '^#' ../emacs-pkgs-ubuntu24.txt | tr '\n' ' ')

Usage:
  bazel --nohome_rc build //:emacs_package
  EMACS_REF=emacs-31.1 bazel --nohome_rc build //:emacs_ref_package
  bazel run //:install
  EMACS_REF=emacs-31.1 bazel run //:install_ref
  bazel run //:install_fonts
  bazel run //:remove
  bazel run //:remove_fonts
  ./deploy.sh               # legacy: build stable + deploy to ~/.local/
  ./deploy_fonts.sh         # legacy: download and install programming fonts

GUI toolkit selection (EMACS_TOOLKIT env var, default: auto-detect):
  Auto-detection (when EMACS_TOOLKIT is unset):
    Wayland session (XDG_SESSION_TYPE=wayland or WAYLAND_DISPLAY set) → pgtk
    X11 session                                                        → lucid
  lucid — Lucid (Athena/Xaw) toolkit; stable, X11 only
            requires: libxaw7-dev libxt-dev
  pgtk  — Pure GTK3; native Wayland client + X11 via GTK backend
            requires: libgtk-3-dev
            warning: running under X11 (not Wayland) triggers an Emacs warning
            about unsupported configuration, sporadic crashes on large selections,
            and keyboard input problems.  Only use pgtk in a native Wayland session.
  gtk3  — GTK3 with X11; Wayland only via XWayland
            requires: libgtk-3-dev

  EMACS_TOOLKIT=pgtk bazel build //:emacs_package
  EMACS_TOOLKIT=gtk3 bazel run //:install
"""

module(
    name = "emacs-build",
    version = "0.1.1",
)

# sh_binary for bazel run install/remove targets.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Fetch Emacs source archives via our custom module extension.
emacs_sources = use_extension("//:emacs_fetch.bzl", "emacs_sources")
emacs_sources.stable(
    sha256 = "1da5790d9580c81932b5bf700633114468da7b3412d69faa767daebf974f4586",
    strip_prefix = "emacs-31.1",
    url = "https://ftp.gnu.org/gnu/emacs/emacs-31.1.tar.xz",
    version = "31.1",
)
use_repo(emacs_sources, "emacs_src")

# ---------------------------------------------------------------------------
# libtree-sitter — built from source for ABI-15 support.
# Ubuntu 24.04's libtree-sitter-dev (0.20.8) only supports ABI ≤ 14; grammars
# generated by tree-sitter CLI 0.23+ emit LANGUAGE_VERSION 15.
# Emacs master requires ≥ 0.25 for ts_tree_cursor_goto_previous_sibling.
# ---------------------------------------------------------------------------

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file    = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name   = "libtree_sitter_src",
    url    = "https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v0.26.13.tar.gz",
    sha256 = "ece24c3c5e2a76384075e830c7139b59fce8fb01e4ef8436fab08bbe10444c89",
    strip_prefix = "tree-sitter-0.26.13",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["**/.git/**"]),
    visibility = ["//visibility:public"],
)
""",
)

# ---------------------------------------------------------------------------
# Font downloads — programming fonts installed to ~/.local/share/fonts/emacs/
# via //:fonts target and deploy_fonts.sh.  All fonts are released under the
# SIL Open Font License (OFL).
# ---------------------------------------------------------------------------

# JetBrains Mono 2.304 — monospace with ligatures, excellent readability.
# https://www.jetbrains.com/lp/mono/
http_archive(
    name   = "font_jetbrains_mono",
    url    = "https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip",
    sha256 = "6f6376c6ed2960ea8a963cd7387ec9d76e3f629125bc33d1fdcd7eb7012f7bbf",
    build_file_content = """
filegroup(
    name = "ttf_files",
    srcs = glob(["fonts/ttf/*.ttf"]),
    visibility = ["//visibility:public"],
)
""",
)

# Fira Code 6.2 — monospace with programming ligatures.
# https://github.com/tonsky/FiraCode
http_archive(
    name   = "font_fira_code",
    url    = "https://github.com/tonsky/FiraCode/releases/download/6.2/Fira_Code_v6.2.zip",
    sha256 = "0949915ba8eb24d89fd93d10a7ff623f42830d7c5ffc3ecbf960e4ecad3e3e79",
    build_file_content = """
filegroup(
    name = "ttf_files",
    srcs = glob(["ttf/*.ttf"]),
    visibility = ["//visibility:public"],
)
""",
)

# Noto Sans Mono — wide Unicode coverage; excellent fallback / UI font.
# https://github.com/googlefonts/noto-fonts
http_file(
    name = "font_noto_sans_mono_regular",
    url  = "https://cdn.jsdelivr.net/gh/notofonts/notofonts.github.io/fonts/NotoSansMono/hinted/ttf/NotoSansMono-Regular.ttf",
    sha256 = "65b5e2b2c4a1fba9ae8be1f026cb35b03dcb8886d9b2a4147054fde12f7e767d",
    downloaded_file_path = "NotoSansMono-Regular.ttf",
)
http_file(
    name = "font_noto_sans_mono_bold",
    url  = "https://cdn.jsdelivr.net/gh/notofonts/notofonts.github.io/fonts/NotoSansMono/hinted/ttf/NotoSansMono-Bold.ttf",
    sha256 = "a21ea0ba6ea49fda7b34ca39a504b487f1130885d36e1a4f9f4255b3ba6994bc",
    downloaded_file_path = "NotoSansMono-Bold.ttf",
)
